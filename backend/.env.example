# ========================================================
# Connected Vehicle Telemetry System - Backend Environment
# ========================================================

# Server Port
SERVER_PORT=8080

# Active Spring Profile ('default' for Embedded H2, 'mysql' for MySQL)
SPRING_PROFILES_ACTIVE=default

# MySQL Database Configuration (Required only when SPRING_PROFILES_ACTIVE=mysql)
DB_URL=jdbc:mysql://localhost:3306/telemetry_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Telemetry Simulation Thresholds
TELEMETRY_THRESHOLD_OVERSPEED_KMH=105.0
TELEMETRY_THRESHOLD_HIGH_TEMP_C=95.0
TELEMETRY_THRESHOLD_LOW_BATTERY_PERCENT=15.0
