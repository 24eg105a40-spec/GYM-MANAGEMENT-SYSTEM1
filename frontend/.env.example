# ========================================================
# Connected Vehicle Telemetry System - Frontend Environment
# ========================================================
# Base URL for the Spring Boot REST API
# During local development with Vite proxy, '/api' is used by default.
# For production or direct cross-origin backend calls, set:
VITE_API_BASE_URL=/api

# Example for standalone production backend:
# VITE_API_BASE_URL=http://localhost:8080/api

# NOTE: Do NOT store sensitive API keys or secrets in VITE_ variables,
# as all VITE_ prefixed variables are publicly bundled into client-side JS.
