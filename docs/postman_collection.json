{
  "info": {
    "name": "Smart Gym Management API",
    "_postman_id": "smart-gym-management-v1",
    "description": "Comprehensive Postman collection for the Smart Gym Management and Membership Tracking System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Sharma\",\n  \"email\": \"rahul.member@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartgym.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Authenticated User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Membership Plans",
      "item": [
        {
          "name": "Get Active Plans",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/membership-plans", "host": ["{{baseUrl}}"], "path": ["membership-plans"] }
          }
        },
        {
          "name": "Create Plan (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Pro Pass\",\n  \"description\": \"Discounted pass for college students\",\n  \"durationDays\": 60,\n  \"price\": 2500.00,\n  \"facilities\": \"Gym floor, Locker room\",\n  \"includesPersonalTraining\": false,\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/membership-plans", "host": ["{{baseUrl}}"], "path": ["membership-plans"] }
          }
        }
      ]
    },
    {
      "name": "Memberships & Payments",
      "item": [
        {
          "name": "Subscribe to Plan (Member)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/memberships", "host": ["{{baseUrl}}"], "path": ["memberships"] }
          }
        },
        {
          "name": "Record Payment (Member)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"membershipId\": 1,\n  \"amount\": 1500.00,\n  \"paymentMethod\": \"UPI\",\n  \"transactionReference\": \"UPI-REC-998877\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/payments", "host": ["{{baseUrl}}"], "path": ["payments"] }
          }
        },
        {
          "name": "Verify Payment (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/payments/1/verify", "host": ["{{baseUrl}}"], "path": ["admin", "payments", "1", "verify"] }
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Check In (Member)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/attendance/check-in", "host": ["{{baseUrl}}"], "path": ["attendance", "check-in"] }
          }
        },
        {
          "name": "Get My Attendance (Member)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/attendance/my", "host": ["{{baseUrl}}"], "path": ["attendance", "my"] }
          }
        },
        {
          "name": "Admin Attendance Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/attendance/summary", "host": ["{{baseUrl}}"], "path": ["admin", "attendance", "summary"] }
          }
        }
      ]
    },
    {
      "name": "Admin Analytics",
      "item": [
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        }
      ]
    }
  ]
}
